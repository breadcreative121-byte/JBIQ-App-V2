# Copy to .env for local dev. Point the app at the Express backend on your LAN
# (use your machine's LAN IP, not localhost — the simulator/device can't reach
# the host's localhost). Find it with: ipconfig getifaddr en0
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000

# This app uses @react-navigation directly (not expo-router). SDK 56 errors on
# that combo unless this guard is disabled.
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
